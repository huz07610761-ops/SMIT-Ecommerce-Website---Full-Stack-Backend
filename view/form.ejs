<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Create Page</title>
</head>
<body>
    <form action="/form/productadd" method="post">
        <input type="text" name="name" placeholder="Enter your name" /><br><br>
        <input type="number" name="price" placeholder="Enter your Product Price"><br><br>
        <input type="number" name="delPrice" placeholder="Enter your discount Price"><br><br>
        <input type="number" name="rating" placeholder="Enter your rating value"><br><br>
        <input type="text" name="img" placeholder="Enter your Live Image Url"><br><br>
        <button type="submit">Create Product</button>
    </form>
</body>
</html>